# LLM & Search Configurations
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Primary search provider: google or web
SEARCH_PROVIDER=google

# Amazon Product Advertising / Creators API Credentials
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
AMAZON_HOST=webservices.amazon.in
AMAZON_REGION=eu-west-1
AMAZON_CREATOR_TOKEN=

# Flipkart Affiliate API Credentials
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Bing Search API (Optional)
BING_SEARCH_API_KEY=

# Database URL (PostgreSQL default, auto-fallback to SQLite if unavailable)
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/shopping_agent
FALLBACK_SQLITE_URL=sqlite:///./shopping_agent.db

# App settings
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
