# LLM & Search Configurations
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Primary search provider: google or web
SEARCH_PROVIDER=google

# Database URL (PostgreSQL default, auto-fallback to SQLite if unavailable)
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/shopping_agent
FALLBACK_SQLITE_URL=sqlite:///./shopping_agent.db

# App settings
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
